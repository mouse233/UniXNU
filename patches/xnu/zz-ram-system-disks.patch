+fuxi_mdev_add_ro(int id, uint64_t address, uint64_t bytes)
+{
+    if (id < 1 || id > 2 || !bytes || (bytes & 511) || (address & 511) || address > UINT64_MAX - bytes ||
+        mdevlookup(id) != (dev_t)-1 || bytes > ((uint64_t)UINT_MAX << 12) - 4096) return (dev_t)-1;
+    dev_t device = mdevadd(id, address >> 12, (unsigned int)((bytes + (address & 4095) + 4095) >> 12), 0);
+    if (device == (dev_t)-1) return device;
+    mdev[id].mdBias = address & 4095;
+    mdev[id].mdByteSize = bytes;
+    mdev[id].mdFlags |= mdRO;
+    return device;
+}
