+/* RAM-only, single-caller boot probe. Copy scalars before cleanup drops vnodes.
+ * No vnode pointers are retained and no mount decisions depend on this state.
+ * opens is the exact preflight vcount result; apfs=-1 means not called.
+ */
+static struct {
+    const char *stage;
+    uint32_t dev, spec, covered;
+    int opens, apfs;
+} fuxi_ram_mount_diag;
+
+static void
+fuxi_ram_mount_reset(void)
+{
+    fuxi_ram_mount_diag.stage = "arguments";
+    fuxi_ram_mount_diag.dev = (uint32_t)NODEV;
+    fuxi_ram_mount_diag.spec = fuxi_ram_mount_diag.covered = 0;
+    fuxi_ram_mount_diag.opens = fuxi_ram_mount_diag.apfs = -1;
+}
+
+static void
+fuxi_ram_mount_mark(uint32_t flags, const char *stage)
+{
+    if (flags & KERNEL_MOUNT_RAM_SYSTEM) fuxi_ram_mount_diag.stage = stage;
+}
+
+static void
+fuxi_ram_mount_device(uint32_t flags, vnode_t vp)
+{
+    if (!(flags & KERNEL_MOUNT_RAM_SYSTEM)) return;
+    vnode_lock_spin(vp);
+    fuxi_ram_mount_diag.dev = (uint32_t)vp->v_rdev;
+    fuxi_ram_mount_diag.spec = (uint32_t)vp->v_specflags;
+    vnode_unlock(vp);
+}
