+
+/* RAM mount witness: bounded legacy-log tail and vnode_open result.
+ * Logging is left untouched. Only the mounting thread records open results;
+ * other threads can still appear in the shared kernel log tail.
+ */
+extern void bsd_log_lock_safe(void);
+extern void bsd_log_unlock(void);
+static thread_t fuxi_ram_mount_owner;
+static struct {
+    int start, size, open_error;
+    const char *buffer;
+    unsigned opens;
+    char open_path[80], tail[641], text[800];
+} fuxi_ram_mount_evidence;
+
+void fuxi_ram_mount_open_result(const char *, int);
+void
+fuxi_ram_mount_open_result(const char *path, int error)
+{
+    if (os_atomic_load(&fuxi_ram_mount_owner, acquire) != current_thread()) return;
+    fuxi_ram_mount_evidence.opens++;
+    if (error || fuxi_ram_mount_evidence.open_error == -1) {
+        fuxi_ram_mount_evidence.open_error = error;
+        strlcpy(fuxi_ram_mount_evidence.open_path, path ? path : "(null)",
+            sizeof(fuxi_ram_mount_evidence.open_path));
+    }
+}
+
+static void
+fuxi_ram_mount_witness_begin(uint32_t flags)
+{
+    if (!(flags & KERNEL_MOUNT_RAM_SYSTEM)) return;
+    bzero(&fuxi_ram_mount_evidence, sizeof(fuxi_ram_mount_evidence));
+    fuxi_ram_mount_evidence.start = -1;
+    fuxi_ram_mount_evidence.open_error = -1;
+    bsd_log_lock_safe();
+    if (msgbufp && msgbufp->msg_magic == MSG_MAGIC && msgbufp->msg_bufc &&
+        msgbufp->msg_size > 0 && msgbufp->msg_size <= MAX_MSG_BSIZE &&
+        msgbufp->msg_bufx >= 0 && msgbufp->msg_bufx < msgbufp->msg_size) {
+        fuxi_ram_mount_evidence.start = msgbufp->msg_bufx;
+        fuxi_ram_mount_evidence.size = msgbufp->msg_size;
+        fuxi_ram_mount_evidence.buffer = msgbufp->msg_bufc;
+    }
+    bsd_log_unlock();
+    os_atomic_store(&fuxi_ram_mount_owner, current_thread(), release);
+}
+
+static void
+fuxi_ram_mount_witness_end(uint32_t flags)
+{
+    if (!(flags & KERNEL_MOUNT_RAM_SYSTEM)) return;
+    os_atomic_store(&fuxi_ram_mount_owner, NULL, release);
+    bsd_log_lock_safe();
+    if (msgbufp && msgbufp->msg_magic == MSG_MAGIC &&
+        fuxi_ram_mount_evidence.start >= 0 &&
+        msgbufp->msg_size == fuxi_ram_mount_evidence.size &&
+        msgbufp->msg_bufc == fuxi_ram_mount_evidence.buffer &&
+        msgbufp->msg_bufx >= 0 && msgbufp->msg_bufx < msgbufp->msg_size) {
+        unsigned size = (unsigned)msgbufp->msg_size;
+        unsigned end = (unsigned)msgbufp->msg_bufx;
+        unsigned count = (end + size - (unsigned)fuxi_ram_mount_evidence.start) % size;
+        if (count > sizeof(fuxi_ram_mount_evidence.tail) - 1)
+            count = sizeof(fuxi_ram_mount_evidence.tail) - 1;
+        unsigned start = (end + size - count) % size;
+        for (unsigned i = 0; i < count; i++) {
+            unsigned char c = msgbufp->msg_bufc[(start + i) % size];
+            fuxi_ram_mount_evidence.tail[i] = (c == '\n' || c == '\t' || (c >= 32 && c <= 126)) ? c : '.';
+        }
+        fuxi_ram_mount_evidence.tail[count] = 0;
+    }
+    bsd_log_unlock();
+    snprintf(fuxi_ram_mount_evidence.text, sizeof(fuxi_ram_mount_evidence.text),
+        "open=%d count=%u %s\nLOG tail (bounded):\n%s",
+        fuxi_ram_mount_evidence.open_error, fuxi_ram_mount_evidence.opens,
+        fuxi_ram_mount_evidence.open_path,
+        fuxi_ram_mount_evidence.tail[0] ? fuxi_ram_mount_evidence.tail : "(none/unavailable)");
+}
+
+static const char *
+fuxi_ram_mount_witness(void)
+{
+    return fuxi_ram_mount_diag.apfs == -1 ? "APFS not called" : fuxi_ram_mount_evidence.text;
 }
 
